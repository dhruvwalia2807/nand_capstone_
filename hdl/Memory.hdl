// Memory map: RAM16K, Screen, Keyboard.
CHIP Memory {
 IN in[16], load, address[15];
 OUT out[16];
 PARTS:
 DMux(in=load,sel=address[14],a=ramLoad,b=upperLoad);
 DMux(in=upperLoad,sel=address[13],a=screenLoad,b=keyboardLoad);
 RAM16K(in=in,load=ramLoad,address=address[0..13],out=ramValue);
 Screen(in=in,load=screenLoad,address=address[0..12],out=screenValue);
 Keyboard(out=keyboardValue);
 Mux16(a=screenValue,b=keyboardValue,sel=address[13],out=upperValue);
 Mux16(a=ramValue,b=upperValue,sel=address[14],out=out);
}